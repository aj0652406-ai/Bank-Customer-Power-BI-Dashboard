{
  "name": "SemanticModel",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "tables": [
      {
        "name": "Bank",
        "columns": [
          {
            "name": "Customer_ID",
            "dataType": "int64",
            "sourceColumn": "Customer_ID",
            "summarizeBy": "none",
            "formatString": "#,0"
          },
          {
            "name": "Gender",
            "dataType": "string",
            "sourceColumn": "Gender",
            "summarizeBy": "none"
          },
          {
            "name": "Age_Group",
            "dataType": "string",
            "sourceColumn": "Age_Group",
            "summarizeBy": "none",
            "sortByColumn": "Age_Group_Sort"
          },
          {
            "name": "Income_Group",
            "dataType": "string",
            "sourceColumn": "Income_Group",
            "summarizeBy": "none",
            "sortByColumn": "Income_Group_Sort"
          },
          {
            "name": "City",
            "dataType": "string",
            "sourceColumn": "City",
            "summarizeBy": "none"
          },
          {
            "name": "Account_Type",
            "dataType": "string",
            "sourceColumn": "Account_Type",
            "summarizeBy": "none"
          },
          {
            "name": "Balance",
            "dataType": "double",
            "sourceColumn": "Balance",
            "summarizeBy": "average",
            "formatString": "₹#,0;(-₹#,0);₹0"
          },
          {
            "name": "Churn",
            "dataType": "string",
            "sourceColumn": "Churn",
            "summarizeBy": "none"
          },
          {
            "name": "Age_Group_Sort",
            "dataType": "int64",
            "type": "calculated",
            "expression": "SWITCH ( TRUE(), 'Bank'[Age_Group] = \"18-25\", 1, 'Bank'[Age_Group] = \"26-35\", 2, 'Bank'[Age_Group] = \"36-45\", 3, 'Bank'[Age_Group] = \"46-55\", 4, 'Bank'[Age_Group] = \"56-65\", 5, 6 )",
            "summarizeBy": "none",
            "isDataTypeInferred": false,
            "isHidden": true
          },
          {
            "name": "Income_Group_Sort",
            "dataType": "int64",
            "type": "calculated",
            "expression": "SWITCH ( 'Bank'[Income_Group], \"Low Income\", 1, \"Middle Income\", 2, \"High Income\", 3, 9 )",
            "summarizeBy": "none",
            "isDataTypeInferred": false,
            "isHidden": true
          }
        ],
        "measures": [
          {
            "name": "Total Customers",
            "expression": "DISTINCTCOUNT ( 'Bank'[Customer_ID] )",
            "formatString": "#,0"
          },
          {
            "name": "Average Balance",
            "expression": "AVERAGE ( 'Bank'[Balance] )",
            "formatString": "₹#,0"
          },
          {
            "name": "Churned Customers",
            "expression": "CALCULATE ( [Total Customers], 'Bank'[Churn] = \"Yes\" )",
            "formatString": "#,0"
          },
          {
            "name": "Churn Rate",
            "expression": "DIVIDE ( [Churned Customers], [Total Customers], 0 )",
            "formatString": "0.0%"
          }
        ],
        "partitions": [
          {
            "name": "Bank-partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Encoded = Text.Combine({",
                "            \"\",",
                "            \"\",",
                "            \"\",",
                "            \"\",",
                "            \"\",",
                "            \"\",",
                "            \"\",",
                "            \"\",",
                "            \"\",",
                "            \"\",",
                "            \"\",",
                "            \"\",",
                "            \"\",",
                "            \"\",",
                "            \"\",",
                "            \"\",",
                "            \"\",",
                "            \"\",",
                "            \"\",",
                "            \"\",",
                "            \"\",",
                "            \"\",",
                "            \"\",",
                "            \"\"",
                "        }),",
                "    Compressed = Binary.FromText(Encoded, BinaryEncoding.Base64),",
                "    Decompressed = Binary.Decompress(Compressed, Compression.Deflate),",
                "    Source = Csv.Document(Decompressed, [Delimiter=\",\", Columns=8, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    #\"Promoted Headers\" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Promoted Headers\", {",
                "        {\"Customer_ID\", Int64.Type},",
                "        {\"Gender\", type text},",
                "        {\"Age_Group\", type text},",
                "        {\"Income_Group\", type text},",
                "        {\"City\", type text},",
                "        {\"Account_Type\", type text},",
                "        {\"Balance\", type number},",
                "        {\"Churn\", type text}",
                "    })",
                "in",
                "    #\"Changed Type\""
              ]
            }
          }
        ]
      }
    ],
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"Bank\"]"
      }
    ]
  }
}